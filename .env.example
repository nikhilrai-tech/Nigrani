# Copy to .env and fill in. Never commit .env.

# Required: password for the Nigrani web UI (username defaults to "admin").
NIGRANI_PASSWORD=change-me-to-a-long-random-string

# Optional: signing key for login cookies. Set it so sessions survive restarts.
# NIGRANI_SECRET=

# Host port Nigrani is published on.
NIGRANI_PORT=8080

# Referenced from nigrani.yaml as ${NAME}; keeps secrets out of the config file.
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GITHUB_TOKEN=
